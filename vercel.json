{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/pix.js":              { "maxDuration": 30 },
    "api/webhook/payfort.js":  { "maxDuration": 30 },
    "api/webhook/suitpay.js":  { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/pix/:action",  "destination": "/api/pix?action=:action"  },
    { "source": "/((?!api/).*)",     "destination": "/index.html"               }
  ]
}

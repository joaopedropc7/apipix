<%- include('partials/head') %>
</head>
<body>
<%- include('partials/sidebar') %>

<div class="main-content">
  <div class="top-bar">
    <div>
      <div class="page-title">Configurações</div>
      <div class="page-sub">Gerencie integrações e preferências do sistema</div>
    </div>
  </div>

  <div class="content-area">
    <% if (success) { %>
      <div class="alert alert-success alert-custom d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-check-circle-fill fs-5"></i><span><%= success %></span>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger alert-custom d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-x-circle-fill fs-5"></i><span><%= error %></span>
      </div>
    <% } %>

    <div class="row g-3">
      <div class="col-lg-7">

        <!-- SuitPay -->
        <div class="form-section mb-3">
          <div class="form-section-title">
            <i class="bi bi-qr-code-scan"></i> Credenciais SuitPay
            <% if (settings.suitpay.ci && settings.suitpay.cs) { %>
              <span class="badge bg-success ms-auto" style="font-size:0.7rem">Configurado</span>
            <% } else { %>
              <span class="badge bg-warning text-dark ms-auto" style="font-size:0.7rem">Não configurado</span>
            <% } %>
          </div>
          <form method="POST" action="/settings/suitpay">
            <div class="mb-3">
              <label class="form-label">Client ID (ci)</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                <input type="text" name="ci" class="form-control"
                  placeholder="testesandbox_1687443996536"
                  value="<%= settings.suitpay.ci %>" autocomplete="off">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Client Secret (cs)</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                <input type="password" name="cs" id="csField" class="form-control"
                  placeholder="••••••••••••••••••"
                  value="<%= settings.suitpay.cs %>" autocomplete="off">
                <button class="btn btn-outline-secondary" type="button" onclick="toggleField('csField','csEye')">
                  <i class="bi bi-eye" id="csEye"></i>
                </button>
              </div>
            </div>
            <div class="mb-4">
              <label class="form-label">Ambiente</label>
              <select name="environment" class="form-select">
                <option value="sandbox" <%= settings.suitpay.environment !== 'production' ? 'selected' : '' %>>Sandbox (Testes)</option>
                <option value="production" <%= settings.suitpay.environment === 'production' ? 'selected' : '' %>>Produção</option>
              </select>
              <div class="form-text">
                Sandbox: <code>https://sandbox.ws.suitpay.app</code> &nbsp;|&nbsp;
                Produção: <code>https://ws.suitpay.app</code>
              </div>
            </div>
            <button type="submit" class="btn-primary-custom">
              <i class="bi bi-save"></i> Salvar Credenciais SuitPay
            </button>
          </form>
        </div>

        <!-- API Key -->
        <div class="form-section mb-3">
          <div class="form-section-title"><i class="bi bi-shield-lock"></i> API Key — Autenticação da sua API</div>
          <div class="mb-3">
            <label class="form-label">Chave para autenticar requisições dos seus clientes</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-key"></i></span>
              <input type="text" id="apiKeyField" class="form-control font-monospace"
                value="<%= settings.apiKey || 'Não gerada' %>" readonly style="font-size:0.85rem">
              <button class="btn btn-outline-secondary" type="button" onclick="copyApiKey()" title="Copiar">
                <i class="bi bi-clipboard" id="copyIcon"></i>
              </button>
            </div>
            <div class="form-text">Envie no header de cada requisição: <code>api-key: <%= settings.apiKey || '...' %></code></div>
          </div>
          <form method="POST" action="/settings/regenerate-key" onsubmit="return confirm('Gerar nova API Key? A chave atual deixará de funcionar.')">
            <button type="submit" class="btn btn-sm btn-outline-warning">
              <i class="bi bi-arrow-clockwise me-1"></i>Gerar Nova API Key
            </button>
          </form>
        </div>

        <!-- URL do servidor -->
        <div class="form-section mb-3">
          <div class="form-section-title"><i class="bi bi-globe"></i> URL do Servidor</div>
          <form method="POST" action="/settings/server">
            <div class="mb-4">
              <label class="form-label">URL Base do seu Servidor</label>
              <input type="text" name="serverBaseUrl" class="form-control"
                placeholder="https://meusite.com  ou  https://xxxx.ngrok.io"
                value="<%= settings.serverBaseUrl || '' %>">
              <div class="form-text">
                Usada para gerar automaticamente o <strong>callbackUrl</strong> nas transações.<br>
                Webhook endpoint: <code><%= settings.serverBaseUrl ? settings.serverBaseUrl.replace(/\/$/, '') + '/webhook/suitpay' : '{URL_BASE}/webhook/suitpay' %></code>
              </div>
            </div>
            <button type="submit" class="btn-primary-custom">
              <i class="bi bi-save"></i> Salvar URL
            </button>
          </form>
        </div>

      </div>

      <div class="col-lg-5">

        <!-- Status Supabase (lido do .env) -->
        <div class="form-section mb-3">
          <div class="form-section-title">
            <i class="bi bi-database"></i> Supabase (via .env)
            <% if (supabaseConfigured) { %>
              <span class="badge bg-success ms-auto" style="font-size:0.7rem">Conectado</span>
            <% } else { %>
              <span class="badge bg-danger ms-auto" style="font-size:0.7rem">Não configurado</span>
            <% } %>
          </div>

          <% if (supabaseConfigured) { %>
            <div class="d-flex align-items-center gap-2 p-3 bg-light rounded mb-3">
              <i class="bi bi-check-circle-fill text-success fs-5"></i>
              <div>
                <div class="fw-semibold" style="font-size:0.875rem">Credenciais carregadas do <code>.env</code></div>
                <div class="text-muted" style="font-size:0.8rem"><%= supabaseUrl %></div>
              </div>
            </div>
          <% } else { %>
            <div class="d-flex align-items-start gap-2 p-3 rounded mb-3" style="background:#fff5f5;border:1px solid #fed7d7">
              <i class="bi bi-exclamation-triangle-fill text-danger mt-1"></i>
              <div style="font-size:0.85rem">
                Variáveis de ambiente não encontradas. Edite o arquivo <code>.env</code> na raiz do projeto:
              </div>
            </div>
          <% } %>

          <div class="bg-dark text-light rounded p-3" style="font-size:0.82rem;font-family:monospace">
            <div class="text-warning mb-1"># .env</div>
            <div>SUPABASE_URL=<span class="text-success">https://xxx.supabase.co</span></div>
            <div>SUPABASE_ANON_KEY=<span class="text-success">eyJhbGci...</span></div>
          </div>
          <div class="form-text mt-2">
            <i class="bi bi-info-circle me-1"></i>
            Após editar o <code>.env</code>, reinicie o servidor para aplicar as alterações.
          </div>
        </div>

        <!-- Alterar Senha -->
        <div class="form-section mb-3">
          <div class="form-section-title"><i class="bi bi-lock-fill"></i> Alterar Senha do Admin</div>
          <form method="POST" action="/settings/password">
            <div class="mb-3">
              <label class="form-label">Senha Atual</label>
              <input type="password" name="currentPassword" class="form-control" placeholder="••••••••" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Nova Senha</label>
              <input type="password" name="newPassword" class="form-control" placeholder="Mínimo 6 caracteres" minlength="6" required>
            </div>
            <div class="mb-4">
              <label class="form-label">Confirmar Nova Senha</label>
              <input type="password" name="confirmPassword" class="form-control" placeholder="Repita a nova senha" required>
            </div>
            <button type="submit" class="btn-primary-custom">
              <i class="bi bi-key"></i> Alterar Senha
            </button>
          </form>
        </div>

        <!-- Info Card -->
        <div class="card-panel">
          <div class="card-panel-body">
            <div class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Status do Sistema</div>
            <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:0.85rem">
              <span class="text-muted">Usuário admin</span>
              <code><%= settings.adminUser %></code>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:0.85rem">
              <span class="text-muted">Ambiente SuitPay</span>
              <span class="badge <%= settings.suitpay.environment === 'production' ? 'bg-success' : 'bg-secondary' %>">
                <%= settings.suitpay.environment %>
              </span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:0.85rem">
              <span class="text-muted">Supabase</span>
              <span class="badge <%= supabaseConfigured ? 'bg-success' : 'bg-danger' %>">
                <%= supabaseConfigured ? 'Conectado' : 'Não configurado' %>
              </span>
            </div>
            <% if (settings.serverBaseUrl) { %>
            <div style="font-size:0.82rem;margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid var(--border)">
              <div class="text-muted mb-1">Webhook URL:</div>
              <code style="font-size:0.75rem;word-break:break-all"><%= settings.serverBaseUrl.replace(/\/$/, '') %>/webhook/suitpay</code>
            </div>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
function toggleField(fieldId, eyeId) {
  const f = document.getElementById(fieldId);
  const i = document.getElementById(eyeId);
  f.type = f.type === 'password' ? 'text' : 'password';
  i.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}

function copyApiKey() {
  const val = document.getElementById('apiKeyField').value;
  navigator.clipboard.writeText(val).then(() => {
    const i = document.getElementById('copyIcon');
    i.className = 'bi bi-check-lg text-success';
    setTimeout(() => i.className = 'bi bi-clipboard', 1500);
  });
}
</script>
</body>
</html>

<%- include('partials/head') %>
</head>
<body>
<%- include('partials/sidebar') %>

<div class="main-content">
  <div class="top-bar">
    <div>
      <div class="page-title">Logs do Sistema</div>
      <div class="page-sub"><%= total %> registro(s) encontrado(s)</div>
    </div>
    <form method="POST" action="/logs/clear" onsubmit="return confirm('Limpar logs com mais de 30 dias?')">
      <button type="submit" class="btn btn-sm btn-outline-danger">
        <i class="bi bi-trash me-1"></i>Limpar antigos
      </button>
    </form>
  </div>

  <div class="content-area">
    <% if (supabaseWarning) { %>
      <div class="alert alert-danger alert-custom d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-database-x fs-5"></i>
        <div>Supabase não configurado. <a href="/settings" class="fw-semibold">Configurar agora</a></div>
      </div>
    <% } %>
    <!-- Filters -->
    <div class="card-panel mb-4">
      <div class="card-panel-body">
        <form method="GET" action="/logs" class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label">Nível</label>
            <select name="level" class="form-select">
              <option value="">Todos</option>
              <option value="info" <%= level==='info'?'selected':'' %>>Info</option>
              <option value="warn" <%= level==='warn'?'selected':'' %>>Aviso</option>
              <option value="error" <%= level==='error'?'selected':'' %>>Erro</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Tipo</label>
            <select name="type" class="form-select">
              <option value="">Todos</option>
              <option value="auth" <%= type==='auth'?'selected':'' %>>Auth</option>
              <option value="transaction" <%= type==='transaction'?'selected':'' %>>Transação</option>
              <option value="settings" <%= type==='settings'?'selected':'' %>>Configurações</option>
              <option value="webhook" <%= type==='webhook'?'selected':'' %>>Webhook</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn-primary-custom w-100"><i class="bi bi-funnel"></i> Filtrar</button>
          </div>
          <div class="col-md-2">
            <a href="/logs" class="btn-outline-custom w-100">Limpar</a>
          </div>
        </form>
      </div>
    </div>

    <!-- Logs Table -->
    <div class="card-panel">
      <div class="table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width:40px">ID</th>
              <th style="width:70px">Nível</th>
              <th style="width:100px">Tipo</th>
              <th>Mensagem</th>
              <th style="width:160px">Data/Hora</th>
              <th style="width:60px">Detalhes</th>
            </tr>
          </thead>
          <tbody>
            <% if (logs.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted py-5">
                <i class="bi bi-terminal" style="font-size:2rem;display:block;margin-bottom:0.5rem;opacity:0.3"></i>
                Nenhum log encontrado
              </td></tr>
            <% } %>
            <% logs.forEach(log => { %>
            <tr>
              <td class="text-muted" style="font-size:0.75rem">#<%= log.id || '-' %></td>
              <td>
                <span class="badge-status
                  <%= log.level === 'info' ? 'badge-paid' : log.level === 'warn' ? 'badge-pending' : 'badge-error' %>"
                  style="font-size:0.7rem">
                  <%= log.level === 'info' ? 'INFO' : log.level === 'warn' ? 'AVISO' : 'ERRO' %>
                </span>
              </td>
              <td><code style="font-size:0.78rem"><%= log.type %></code></td>
              <td style="font-size:0.875rem"><%= log.message %></td>
              <td class="text-muted" style="font-size:0.78rem"><%= log.created_at ? new Date(log.created_at).toLocaleString('pt-BR') : '-' %></td>
              <td>
                <% if (log.details && (typeof log.details === 'object' ? Object.keys(log.details).length : log.details)) { %>
                  <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#detailModal"
                  onclick="showDetail(`<%= JSON.stringify(log.details).replace(/`/g,'\\`').replace(/\\/g,'\\\\') %>`)">
                    <i class="bi bi-code"></i>
                  </button>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (pages > 1) { %>
      <div class="d-flex justify-content-center p-3">
        <div class="pagination-custom">
          <a href="?page=<%= page-1 %>&level=<%= level %>&type=<%= type %>" class="page-btn <%= page<=1?'disabled':'' %>"><i class="bi bi-chevron-left"></i></a>
          <% for(let i=Math.max(1,page-2); i<=Math.min(pages,page+2); i++) { %>
            <a href="?page=<%= i %>&level=<%= level %>&type=<%= type %>" class="page-btn <%= i===page?'active':'' %>"><%= i %></a>
          <% } %>
          <a href="?page=<%= page+1 %>&level=<%= level %>&type=<%= type %>" class="page-btn <%= page>=pages?'disabled':'' %>"><i class="bi bi-chevron-right"></i></a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content rounded-4">
      <div class="modal-header border-0">
        <h6 class="modal-title fw-bold">Detalhes do Log</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <pre id="detailContent" class="bg-light p-3 rounded" style="font-size:0.78rem;max-height:400px;overflow:auto"></pre>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
function showDetail(raw) {
  try {
    const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
    document.getElementById('detailContent').textContent = JSON.stringify(parsed, null, 2);
  } catch(e) {
    document.getElementById('detailContent').textContent = raw;
  }
}
</script>
</body>
</html>

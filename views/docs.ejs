<%- include('partials/head') %>
</head>
<body>
<%- include('partials/sidebar') %>

<div class="main-content">
  <div class="top-bar">
    <div>
      <div class="page-title">Documentação</div>
      <div class="page-sub">Referência da API SuitPay, SQL das tabelas e configuração de webhooks</div>
    </div>
    <span class="badge <%= environment === 'production' ? 'bg-success' : 'bg-secondary' %> fs-6 px-3">
      Ambiente: <%= environment %>
    </span>
  </div>

  <div class="content-area">

    <!-- SQL TABLES SECTION -->
    <div id="sql" class="card-panel mb-4">
      <div class="card-panel-header">
        <span class="card-panel-title"><i class="bi bi-database me-2 text-primary"></i>SQL — Criar Tabelas no Supabase</span>
      </div>
      <div class="card-panel-body">
        <p class="text-muted mb-3">
          No painel do Supabase, acesse <strong>SQL Editor</strong> e execute o script abaixo para criar todas as tabelas necessárias:
        </p>

        <pre class="bg-dark text-light p-3 rounded mb-3" style="font-size:0.78rem;overflow-x:auto">-- ============================================================
-- PIX Admin — Tabelas Supabase
-- Execute no SQL Editor do seu projeto Supabase
-- ============================================================

-- Tabela de Transações PIX
CREATE TABLE IF NOT EXISTS transactions (
  id                  UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  request_number      TEXT NOT NULL,
  id_transaction      TEXT,
  amount              NUMERIC(12,2) NOT NULL,
  shipping_amount     NUMERIC(12,2) DEFAULT 0,
  discount_amount     NUMERIC(12,2) DEFAULT 0,
  client_name         TEXT NOT NULL,
  client_document     TEXT NOT NULL,
  client_email        TEXT,
  client_phone        TEXT,
  due_date            TEXT NOT NULL,
  status              TEXT DEFAULT 'pending',
  payment_code        TEXT,
  payment_code_base64 TEXT,
  payment_date        TIMESTAMPTZ,
  paid_value          NUMERIC(12,2),
  payer_name          TEXT,
  payer_tax_id        TEXT,
  callback_url        TEXT,
  username_checkout   TEXT,
  raw_request         JSONB,
  raw_response        JSONB,
  created_at          TIMESTAMPTZ DEFAULT NOW(),
  updated_at          TIMESTAMPTZ DEFAULT NOW()
);

-- Se a tabela já existir, adicione as colunas novas:
-- ALTER TABLE transactions ADD COLUMN IF NOT EXISTS paid_value   NUMERIC(12,2);
-- ALTER TABLE transactions ADD COLUMN IF NOT EXISTS payer_name   TEXT;
-- ALTER TABLE transactions ADD COLUMN IF NOT EXISTS payer_tax_id TEXT;

-- Tabela de Logs do sistema
CREATE TABLE IF NOT EXISTS logs (
  id         BIGSERIAL PRIMARY KEY,
  level      TEXT NOT NULL,
  type       TEXT NOT NULL,
  message    TEXT NOT NULL,
  details    JSONB,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Tabela de Webhooks recebidos da SuitPay
CREATE TABLE IF NOT EXISTS webhooks (
  id             BIGSERIAL PRIMARY KEY,
  id_transaction TEXT,
  payload        JSONB NOT NULL,
  processed_at   TIMESTAMPTZ DEFAULT NOW()
);

-- Índices para performance
CREATE INDEX IF NOT EXISTS idx_transactions_status         ON transactions(status);
CREATE INDEX IF NOT EXISTS idx_transactions_id_transaction ON transactions(id_transaction);
CREATE INDEX IF NOT EXISTS idx_transactions_created_at     ON transactions(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_logs_created_at             ON logs(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_logs_level                  ON logs(level);
CREATE INDEX IF NOT EXISTS idx_webhooks_id_transaction     ON webhooks(id_transaction);</pre>

        <div class="alert alert-info alert-custom d-flex align-items-center gap-2 mb-0">
          <i class="bi bi-lightbulb fs-5"></i>
          <div>
            <strong>Row Level Security (RLS):</strong> Por padrão o Supabase habilita RLS nas tabelas.
            Desative ou configure políticas liberando acesso server-side com a <strong>service_role key</strong> (recomendado para produção), ou desabilite RLS durante testes:
            <code class="ms-1">ALTER TABLE transactions DISABLE ROW LEVEL SECURITY;</code>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-lg-8">

        <!-- Endpoint: Gerar QR Code -->
        <div class="card-panel mb-3">
          <div class="card-panel-header">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-success" style="font-size:0.8rem">POST</span>
              <code class="fw-bold">/api/v1/gateway/request-qrcode</code>
            </div>
          </div>
          <div class="card-panel-body">
            <p class="text-muted mb-3">Gera um QR Code PIX para pagamento. Retorna o código copia-e-cola e a imagem base64 do QR code.</p>

            <div class="fw-semibold mb-2" style="font-size:0.85rem">Base URL</div>
            <div class="bg-light rounded p-2 mb-3" style="font-family:monospace;font-size:0.85rem"><%= baseUrl %></div>

            <div class="fw-semibold mb-2" style="font-size:0.85rem">Headers</div>
            <div class="table-wrapper mb-3">
              <table class="admin-table">
                <thead><tr><th>Header</th><th>Descrição</th></tr></thead>
                <tbody>
                  <tr><td><code>ci</code></td><td>Client ID da SuitPay</td></tr>
                  <tr><td><code>cs</code></td><td>Client Secret da SuitPay</td></tr>
                  <tr><td><code>Content-Type</code></td><td><code>application/json</code></td></tr>
                </tbody>
              </table>
            </div>

            <div class="fw-semibold mb-2" style="font-size:0.85rem">Body (JSON)</div>
            <pre class="bg-light p-3 rounded mb-3" style="font-size:0.78rem;overflow-x:auto">{
  "requestNumber": "12345",
  "dueDate": "2025-12-31",
  "amount": 300.00,
  "shippingAmount": 0.0,
  "discountAmount": 0.0,
  "usernameCheckout": "checkout",
  "callbackUrl": "https://seu-servidor.com/webhook/suitpay",
  "client": {
    "name": "José da Silva",
    "document": "927.300.300-18",
    "phoneNumber": "62999815500",
    "email": "josesilva@gmail.com",
    "address": {
      "codIbge": "5208707",
      "street": "Rua Paraíba",
      "number": "150",
      "complement": "",
      "zipCode": "74663-520",
      "neighborhood": "Goiânia 2",
      "city": "Goiânia",
      "state": "GO"
    }
  },
  "products": [
    { "description": "Tênis", "quantity": 1, "value": 200.0 },
    { "description": "Camiseta M", "quantity": 2, "value": 50.0 }
  ]
}</pre>

            <div class="fw-semibold mb-2" style="font-size:0.85rem">Resposta de Sucesso (200)</div>
            <pre class="bg-light p-3 rounded mb-3" style="font-size:0.78rem;overflow-x:auto">{
  "idTransaction": "0b935d10-3c90-4af3-8776-dd18622a7941",
  "paymentCode": "00020101021226890014br.gov.bcb.pix2567brcode-h...",
  "response": "OK",
  "paymentCodeBase64": "iVBORw0KGgoAAAANSUhEUgAAAPoAAAD6..."
}</pre>
            <div class="alert alert-warning alert-custom" style="font-size:0.82rem">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Atenção:</strong> O campo <code>paymentCodeBase64</code> é o PNG do QR Code em base64 <strong>sem</strong> o prefixo <code>data:image/png;base64,</code>. O sistema adiciona o prefixo automaticamente ao exibir.
            </div>
          </div>
        </div>

        <!-- Webhook -->
        <div class="card-panel mb-3">
          <div class="card-panel-header">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-info text-dark" style="font-size:0.8rem">WEBHOOK</span>
              <code class="fw-bold">POST /webhook/suitpay</code>
            </div>
          </div>
          <div class="card-panel-body">
            <p class="text-muted mb-3">
              A SuitPay envia uma requisição POST para o <code>callbackUrl</code> configurado na criação do PIX quando o status muda.
              O sistema atualiza automaticamente o status da transação no Supabase.
            </p>

            <div class="fw-semibold mb-2" style="font-size:0.85rem">Payload recebido (pagamento confirmado)</div>
            <pre class="bg-light p-3 rounded mb-3" style="font-size:0.78rem">{
  "idTransaction":   "205bb038-9462-463c-98be-06ef845d7b48",
  "typeTransaction": "PIX",
  "statusTransaction": "PAID_OUT",
  "value":           1.00,
  "payerName":       "JOAO PEDRO PEREIRA DA CUNHA",
  "payerTaxId":      "04749338303",
  "paymentDate":     "12/05/2026 23:20:00",
  "paymentCode":     "00020101021226750014br.gov.bcb.pix...",
  "requestNumber":   "12345"
}</pre>
            <div class="alert alert-warning alert-custom mb-3" style="font-size:0.82rem">
              <i class="bi bi-exclamation-circle me-2"></i>
              <strong>Atenção:</strong> <code>paymentDate</code> vem no formato brasileiro <code>DD/MM/YYYY HH:MM:SS</code>.
              O sistema converte automaticamente para ISO antes de salvar no Supabase.
            </div>

            <div class="fw-semibold mb-2" style="font-size:0.85rem">Campos salvos do webhook</div>
            <div class="table-wrapper mb-3">
              <table class="admin-table">
                <thead><tr><th>Campo SuitPay</th><th>Coluna Supabase</th><th>Descrição</th></tr></thead>
                <tbody>
                  <tr><td><code>statusTransaction</code></td><td><code>status</code></td><td>Convertido para: paid / cancelled / expired</td></tr>
                  <tr><td><code>paymentDate</code></td><td><code>payment_date</code></td><td>Convertido de DD/MM/YYYY para ISO</td></tr>
                  <tr><td><code>value</code></td><td><code>paid_value</code></td><td>Valor efetivamente pago</td></tr>
                  <tr><td><code>payerName</code></td><td><code>payer_name</code></td><td>Nome de quem pagou</td></tr>
                  <tr><td><code>payerTaxId</code></td><td><code>payer_tax_id</code></td><td>CPF/CNPJ de quem pagou</td></tr>
                </tbody>
              </table>
            </div>

            <div class="fw-semibold mb-2" style="font-size:0.85rem">Mapeamento de statusTransaction</div>
            <div class="table-wrapper mb-3">
              <table class="admin-table">
                <thead><tr><th>statusTransaction (SuitPay)</th><th>Status interno</th></tr></thead>
                <tbody>
                  <tr><td><code>PAID_OUT</code></td><td><span class="badge-status badge-paid">paid</span></td></tr>
                  <tr><td><code>PAID</code></td><td><span class="badge-status badge-paid">paid</span></td></tr>
                  <tr><td><code>COMPLETED</code></td><td><span class="badge-status badge-paid">paid</span></td></tr>
                  <tr><td><code>CANCELLED</code></td><td><span class="badge-status badge-cancelled">cancelled</span></td></tr>
                  <tr><td><code>EXPIRED</code></td><td><span class="badge-status badge-expired">expired</span></td></tr>
                  <tr><td><code>PENDING</code></td><td><span class="badge-status badge-pending">pending</span></td></tr>
                </tbody>
              </table>
            </div>

            <div class="alert alert-info alert-custom" style="font-size:0.82rem">
              <i class="bi bi-lightbulb me-2"></i>
              <strong>Dica para desenvolvimento local:</strong> Use <strong>ngrok</strong> para expor seu servidor e receber webhooks:
              <br><code>ngrok http 3000</code>
              <br>Cole a URL gerada + <code>/webhook/suitpay</code> em Configurações → URL Base do servidor.
            </div>
          </div>
        </div>

      </div>

      <div class="col-lg-4">
        <!-- Status Codes -->
        <div class="card-panel mb-3">
          <div class="card-panel-header">
            <span class="card-panel-title"><i class="bi bi-circle-fill me-2 text-primary" style="font-size:0.6rem"></i>Status das Transações</span>
          </div>
          <div class="card-panel-body">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge-status badge-pending">Pendente</span>
              <span class="text-muted" style="font-size:0.82rem">Aguardando pagamento</span>
            </div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge-status badge-paid">Paga</span>
              <span class="text-muted" style="font-size:0.82rem">PAID_OUT recebido</span>
            </div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge-status badge-cancelled">Cancelada</span>
              <span class="text-muted" style="font-size:0.82rem">Cancelada/SuitPay</span>
            </div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge-status badge-expired">Expirada</span>
              <span class="text-muted" style="font-size:0.82rem">Prazo vencido</span>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge-status badge-error">Erro</span>
              <span class="text-muted" style="font-size:0.82rem">Falha na geração</span>
            </div>
          </div>
        </div>

        <!-- Fluxo -->
        <div class="card-panel mb-3">
          <div class="card-panel-header">
            <span class="card-panel-title"><i class="bi bi-diagram-3 me-2 text-primary"></i>Fluxo de Pagamento</span>
          </div>
          <div class="card-panel-body" style="font-size:0.82rem">
            <div class="d-flex align-items-start gap-2 mb-2">
              <span class="badge bg-primary rounded-circle" style="min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:0.7rem">1</span>
              <span>Admin cria transação com <code>callbackUrl</code></span>
            </div>
            <div class="d-flex align-items-start gap-2 mb-2">
              <span class="badge bg-primary rounded-circle" style="min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:0.7rem">2</span>
              <span>SuitPay retorna <code>idTransaction</code> + QR Code</span>
            </div>
            <div class="d-flex align-items-start gap-2 mb-2">
              <span class="badge bg-primary rounded-circle" style="min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:0.7rem">3</span>
              <span>Cliente escaneia o QR e paga</span>
            </div>
            <div class="d-flex align-items-start gap-2 mb-2">
              <span class="badge bg-primary rounded-circle" style="min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:0.7rem">4</span>
              <span>SuitPay envia webhook com <code>statusTransaction: PAID_OUT</code></span>
            </div>
            <div class="d-flex align-items-start gap-2">
              <span class="badge bg-success rounded-circle" style="min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:0.7rem">5</span>
              <span>Sistema atualiza status para <strong>Paga</strong> no Supabase</span>
            </div>
          </div>
        </div>

        <!-- Links -->
        <div class="card-panel">
          <div class="card-panel-header">
            <span class="card-panel-title"><i class="bi bi-link-45deg me-2 text-primary"></i>Links Úteis</span>
          </div>
          <div class="card-panel-body d-flex flex-column gap-2">
            <a href="https://supabase.com/dashboard" target="_blank" class="btn-outline-custom" style="justify-content:center">
              <i class="bi bi-box-arrow-up-right"></i> Supabase Dashboard
            </a>
            <a href="https://sandbox.ws.suitpay.app" target="_blank" class="btn-outline-custom" style="justify-content:center">
              <i class="bi bi-box-arrow-up-right"></i> Sandbox SuitPay
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>

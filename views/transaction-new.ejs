<%- include('partials/head') %>
</head>
<body>
<%- include('partials/sidebar') %>

<div class="main-content">
  <div class="top-bar">
    <div>
      <div class="page-title">Nova Transação PIX</div>
      <div class="page-sub">Gerar QR Code via SuitPay</div>
    </div>
    <a href="/transactions" class="btn-outline-custom">
      <i class="bi bi-arrow-left"></i> Voltar
    </a>
  </div>

  <div class="content-area">
    <% if (!configured) { %>
      <div class="alert alert-warning alert-custom d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>CI e CS da SuitPay não configurados. <a href="/settings" class="fw-semibold">Configurar agora</a></div>
      </div>
    <% } %>
    <% if (!supabaseConfigured) { %>
      <div class="alert alert-danger alert-custom d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-database-x fs-5"></i>
        <div>Supabase não configurado — os dados não serão salvos. <a href="/settings" class="fw-semibold">Configurar agora</a></div>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-custom mb-4"><i class="bi bi-x-circle me-2"></i><%= error %></div>
    <% } %>

    <form method="POST" action="/transactions/new" id="txForm">
      <div class="row g-3">
        <div class="col-lg-8">

          <!-- Dados da Transação -->
          <div class="form-section mb-3">
            <div class="form-section-title"><i class="bi bi-receipt"></i> Dados da Transação</div>
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Número do Pedido *</label>
                <input type="text" name="requestNumber" class="form-control" placeholder="Ex: 12345" value="<%= typeof form !== 'undefined' ? form.requestNumber || '' : '' %>" required>
              </div>
              <div class="col-md-4">
                <label class="form-label">Vencimento *</label>
                <input type="date" name="dueDate" class="form-control" value="<%= typeof form !== 'undefined' ? form.dueDate || '' : '' %>" required>
              </div>
              <div class="col-md-4">
                <label class="form-label">Valor Total (R$) *</label>
                <div class="input-group">
                  <span class="input-group-text">R$</span>
                  <input type="number" name="amount" class="form-control" step="0.01" min="0.01" placeholder="0,00" value="<%= typeof form !== 'undefined' ? form.amount || '' : '' %>" required>
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label">Frete (R$)</label>
                <div class="input-group">
                  <span class="input-group-text">R$</span>
                  <input type="number" name="shippingAmount" class="form-control" step="0.01" min="0" value="<%= typeof form !== 'undefined' ? form.shippingAmount || '0' : '0' %>">
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label">Desconto (R$)</label>
                <div class="input-group">
                  <span class="input-group-text">R$</span>
                  <input type="number" name="discountAmount" class="form-control" step="0.01" min="0" value="<%= typeof form !== 'undefined' ? form.discountAmount || '0' : '0' %>">
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label">Username Checkout</label>
                <input type="text" name="usernameCheckout" class="form-control" value="<%= typeof form !== 'undefined' ? form.usernameCheckout || 'checkout' : 'checkout' %>">
              </div>
              <div class="col-12">
                <label class="form-label">URL de Callback (Webhook)</label>
                <input type="url" name="callbackUrl" class="form-control"
                  placeholder="https://seu-servidor.com/webhook/suitpay"
                  value="<%= typeof form !== 'undefined' ? (form.callbackUrl || defaultCallbackUrl) : defaultCallbackUrl %>">
                <% if (defaultCallbackUrl) { %>
                  <div class="form-text text-success"><i class="bi bi-check-circle me-1"></i>URL de webhook configurada automaticamente</div>
                <% } else { %>
                  <div class="form-text text-warning"><i class="bi bi-exclamation-circle me-1"></i>Configure a URL Base do servidor em <a href="/settings">Configurações</a> para preencher automaticamente</div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Dados do Cliente -->
          <div class="form-section mb-3">
            <div class="form-section-title"><i class="bi bi-person-circle"></i> Dados do Cliente</div>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Nome Completo *</label>
                <input type="text" name="clientName" class="form-control" placeholder="José da Silva" value="<%= typeof form !== 'undefined' ? form.clientName || '' : '' %>" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">CPF/CNPJ *</label>
                <input type="text" name="clientDocument" class="form-control" placeholder="000.000.000-00" value="<%= typeof form !== 'undefined' ? form.clientDocument || '' : '' %>" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Telefone</label>
                <input type="text" name="clientPhone" class="form-control" placeholder="62999815500" value="<%= typeof form !== 'undefined' ? form.clientPhone || '' : '' %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">E-mail</label>
                <input type="email" name="clientEmail" class="form-control" placeholder="cliente@email.com" value="<%= typeof form !== 'undefined' ? form.clientEmail || '' : '' %>">
              </div>
            </div>

            <div class="mt-3 pt-3" style="border-top: 1px solid var(--border)">
              <div class="fw-semibold text-muted mb-2" style="font-size:0.8rem"><i class="bi bi-map me-1"></i>ENDEREÇO</div>
              <div class="row g-3">
                <div class="col-md-3">
                  <label class="form-label">CEP</label>
                  <input type="text" name="zipCode" class="form-control" placeholder="74663-520" value="<%= typeof form !== 'undefined' ? form.zipCode || '' : '' %>">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Cód. IBGE</label>
                  <input type="text" name="codIbge" class="form-control" placeholder="5208707" value="<%= typeof form !== 'undefined' ? form.codIbge || '' : '' %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Rua</label>
                  <input type="text" name="street" class="form-control" placeholder="Rua Paraíba" value="<%= typeof form !== 'undefined' ? form.street || '' : '' %>">
                </div>
                <div class="col-md-2">
                  <label class="form-label">Número</label>
                  <input type="text" name="number" class="form-control" placeholder="150" value="<%= typeof form !== 'undefined' ? form.number || '' : '' %>">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Complemento</label>
                  <input type="text" name="complement" class="form-control" value="<%= typeof form !== 'undefined' ? form.complement || '' : '' %>">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Bairro</label>
                  <input type="text" name="neighborhood" class="form-control" value="<%= typeof form !== 'undefined' ? form.neighborhood || '' : '' %>">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Cidade</label>
                  <input type="text" name="city" class="form-control" value="<%= typeof form !== 'undefined' ? form.city || '' : '' %>">
                </div>
                <div class="col-md-2">
                  <label class="form-label">Estado</label>
                  <input type="text" name="state" class="form-control" maxlength="2" placeholder="GO" value="<%= typeof form !== 'undefined' ? form.state || '' : '' %>">
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Produtos -->
        <div class="col-lg-4">
          <div class="form-section">
            <div class="form-section-title d-flex justify-content-between align-items-center">
              <span><i class="bi bi-box"></i> Produtos</span>
              <button type="button" class="btn btn-sm btn-light" onclick="addProduct()"><i class="bi bi-plus"></i></button>
            </div>
            <div id="products-container">
              <div class="product-row mb-3 p-2 bg-light rounded">
                <div class="mb-2">
                  <input type="text" name="product_desc" class="form-control form-control-sm" placeholder="Descrição do produto" required>
                </div>
                <div class="row g-2">
                  <div class="col-5">
                    <input type="number" name="product_qty" class="form-control form-control-sm" placeholder="Qtd" min="1" value="1" required>
                  </div>
                  <div class="col-7">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text" style="border-radius:0.5rem 0 0 0.5rem;font-size:0.75rem">R$</span>
                      <input type="number" name="product_val" class="form-control" style="border-radius:0 0.5rem 0.5rem 0" step="0.01" placeholder="0,00" required>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <button type="submit" class="btn-primary-custom w-100 justify-content-center" <%= !configured ? 'disabled' : '' %>>
                <i class="bi bi-qr-code-scan"></i> Gerar QR Code PIX
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
function addProduct() {
  const c = document.getElementById('products-container');
  const div = document.createElement('div');
  div.className = 'product-row mb-3 p-2 bg-light rounded position-relative';
  div.innerHTML = `
    <button type="button" class="btn btn-sm btn-light position-absolute top-0 end-0 m-1" onclick="this.closest('.product-row').remove()" style="padding:0.1rem 0.4rem;font-size:0.75rem">&times;</button>
    <div class="mb-2"><input type="text" name="product_desc" class="form-control form-control-sm" placeholder="Descrição do produto" required></div>
    <div class="row g-2">
      <div class="col-5"><input type="number" name="product_qty" class="form-control form-control-sm" placeholder="Qtd" min="1" value="1" required></div>
      <div class="col-7"><div class="input-group input-group-sm"><span class="input-group-text" style="border-radius:0.5rem 0 0 0.5rem;font-size:0.75rem">R$</span><input type="number" name="product_val" class="form-control" style="border-radius:0 0.5rem 0.5rem 0" step="0.01" placeholder="0,00" required></div></div>
    </div>`;
  c.appendChild(div);
}
</script>
</body>
</html>

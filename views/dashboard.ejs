<%- include('partials/head') %>
</head>
<body>
<%- include('partials/sidebar') %>

<div class="main-content">
  <div class="top-bar">
    <div>
      <div class="page-title">Dashboard</div>
      <div class="page-sub">Visão geral das transações PIX</div>
    </div>
    <a href="/transactions/new" class="btn-primary-custom">
      <i class="bi bi-plus-lg"></i> Nova Transação
    </a>
  </div>

  <div class="content-area">
    <% if (supabaseWarning) { %>
      <div class="alert alert-danger alert-custom d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-database-x fs-5"></i>
        <div>
          <strong>Supabase não configurado.</strong> Configure as credenciais em
          <a href="/settings" class="fw-semibold">Configurações</a> e crie as tabelas conforme a
          <a href="/docs#sql" class="fw-semibold">Documentação</a>.
        </div>
      </div>
    <% } %>
    <!-- Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon purple"><i class="bi bi-arrow-left-right"></i></div>
          <div>
            <div class="stat-value"><%= stats.total %></div>
            <div class="stat-label">Total de Transações</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon yellow"><i class="bi bi-hourglass-split"></i></div>
          <div>
            <div class="stat-value"><%= stats.pending %></div>
            <div class="stat-label">Pendentes</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon green"><i class="bi bi-check-circle"></i></div>
          <div>
            <div class="stat-value"><%= stats.paid %></div>
            <div class="stat-label">Pagas</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon red"><i class="bi bi-x-circle"></i></div>
          <div>
            <div class="stat-value"><%= stats.cancelled %></div>
            <div class="stat-label">Canceladas/Expiradas</div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-icon blue"><i class="bi bi-cash-stack"></i></div>
          <div>
            <div class="stat-value" style="font-size:1.2rem">R$ <%= (stats.totalAmount || 0).toFixed(2).replace('.',',') %></div>
            <div class="stat-label">Volume Total</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-icon green"><i class="bi bi-wallet2"></i></div>
          <div>
            <div class="stat-value" style="font-size:1.2rem">R$ <%= (stats.paidAmount || 0).toFixed(2).replace('.',',') %></div>
            <div class="stat-label">Volume Recebido</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-icon yellow"><i class="bi bi-clock"></i></div>
          <div>
            <div class="stat-value" style="font-size:1.2rem">R$ <%= (stats.pendingAmount || 0).toFixed(2).replace('.',',') %></div>
            <div class="stat-label">Volume Pendente</div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <!-- Chart -->
      <div class="col-lg-7">
        <div class="card-panel">
          <div class="card-panel-header">
            <span class="card-panel-title"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Transações — Últimos 7 Dias</span>
          </div>
          <div class="card-panel-body">
            <canvas id="txChart" height="180"></canvas>
          </div>
        </div>
      </div>

      <!-- Recent Transactions -->
      <div class="col-lg-5">
        <div class="card-panel h-100">
          <div class="card-panel-header">
            <span class="card-panel-title"><i class="bi bi-clock-history me-2 text-primary"></i>Recentes</span>
            <a href="/transactions" class="btn-outline-custom" style="font-size:0.8rem;padding:0.3rem 0.7rem">Ver Todas</a>
          </div>
          <div class="table-wrapper">
            <table class="admin-table">
              <thead><tr><th>Pedido</th><th>Cliente</th><th>Valor</th><th>Status</th></tr></thead>
              <tbody>
                <% if (recent.length === 0) { %>
                  <tr><td colspan="4" class="text-center text-muted py-4">Nenhuma transação ainda</td></tr>
                <% } %>
                <% recent.forEach(tx => { %>
                <tr>
                  <td><a href="/transactions/<%= tx.id %>" class="text-decoration-none fw-semibold">#<%= tx.request_number %></a></td>
                  <td class="text-muted" style="max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= tx.client_name %></td>
                  <td class="fw-semibold">R$ <%= (tx.amount||0).toFixed(2).replace('.',',') %></td>
                  <td>
                    <span class="badge-status badge-<%= tx.status %>">
                      <%= tx.status === 'pending' ? 'Pendente' : tx.status === 'paid' ? 'Paga' : tx.status === 'cancelled' ? 'Cancelada' : tx.status === 'expired' ? 'Expirada' : tx.status %>
                    </span>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
const raw = <%- last7days %>;
const labels = raw.map(r => r.day);
const data = raw.map(r => r.count);
const ctx = document.getElementById('txChart');
new Chart(ctx, {
  type: 'bar',
  data: {
    labels: labels.length ? labels : ['Sem dados'],
    datasets: [{
      label: 'Transações',
      data: data.length ? data : [0],
      backgroundColor: 'rgba(79,70,229,0.7)',
      borderRadius: 6,
      borderSkipped: false,
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: {
      y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f1f5f9' } },
      x: { grid: { display: false } }
    }
  }
});
</script>
</body>
</html>
